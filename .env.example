GOOGLE_API_KEY=
GEMINI_MODEL=
# Optional: a separate (e.g. lighter/"lite") model for train/gen_synthetic.py
# only, so Phase 6 data generation doesn't share GEMINI_MODEL's daily quota
# with production answering. Defaults to GEMINI_MODEL if unset.
SYNTHETIC_GEMINI_MODEL=
# Optional: an LLM-based alternative to the regex query-detector (see
# config.py's QUERY_PLANNER_MODE). Off by default -- set
# QUERY_PLANNER_MODE=llm to enable it. Defaults to SYNTHETIC_GEMINI_MODEL
# then GEMINI_MODEL if unset.
QUERY_PLANNER_MODE=
QUERY_PLANNER_GEMINI_MODEL=
# Optional backup answer model, used only if every Gemini attempt fails
# (e.g. the free tier's 20-requests/day cap is hit). Free key at
# console.groq.com. Leave blank to disable the fallback entirely.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
